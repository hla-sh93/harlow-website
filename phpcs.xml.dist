<?xml version="1.0"?>
<ruleset name="Harlow">
	<description>The WordPress Coding Standards, as WordPress publishes them, applied to the theme.</description>

	<!--
		Only the theme is a WordPress product. The static reference pages, the tools under
		_tools/ and the local-only plugins under _tools/local/ are how the theme is built and
		checked; they are not shipped.
	-->
	<file>theme</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>theme/assets/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- The full WordPress ruleset: Core, Docs, Extra and the security sniffs. -->
	<rule ref="WordPress"/>

	<!-- What the theme promises in style.css, so the sniffs check against the same floor. -->
	<config name="minimum_wp_version" value="6.7"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Every string a person sees goes through the one text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="harlow"/>
			</property>
		</properties>
	</rule>

	<!--
		Helpers that print only what WordPress has escaped (or nothing), on every path:
		harlow_card_image() returns wp_get_attachment_image() or an empty string;
		harlow_element_attributes() and harlow_link_attributes() escape every value;
		harlow_icon() is wp_kses() with the icon elements; harlow_block_image() is
		wp_get_attachment_image() or an <img> built of escaped values.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="harlow_card_image"/>
				<element value="harlow_element_attributes"/>
				<element value="harlow_link_attributes"/>
				<element value="harlow_icon"/>
				<element value="harlow_block_image"/>
			</property>
		</properties>
	</rule>

	<!-- Everything global carries the theme's name, so it can never collide with a plugin. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="harlow"/>
			</property>
		</properties>
	</rule>
</ruleset>
