{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/call-to-action",
	"title": "Call to Action",
	"icon": "megaphone",
	"category": "design",
	"description": "A picture with a title, words and a button, beside it or over it, with a ribbon and hover effects.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"skin": {
			"type": "string",
			"default": "classic"
		},
		"hasImage": {
			"type": "boolean",
			"default": true
		},
		"image": {
			"type": "integer",
			"default": 0
		},
		"imageSize": {
			"type": "string",
			"default": "full"
		},
		"layout": {
			"type": "string",
			"default": ""
		},
		"graphic": {
			"type": "string",
			"default": "none"
		},
		"graphicImage": {
			"type": "integer",
			"default": 0
		},
		"graphicImageSize": {
			"type": "string",
			"default": "thumbnail"
		},
		"icon": {
			"type": "string",
			"default": "<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-star\" viewBox=\"0 0 576 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M259.3 17.8L194 150.2 47.9 171.5c-26.2 3.8-36.7 36.1-17.7 54.6l105.7 103-25 145.5c-4.5 26.3 23.2 46 46.4 33.7L288 439.6l130.7 68.7c23.2 12.2 50.9-7.4 46.4-33.7l-25-145.5 105.7-103c19-18.5 8.5-50.8-17.7-54.6L382 150.2 316.7 17.8c-11.7-23.6-45.6-23.9-57.4 0z\"></path></svg>"
		},
		"iconView": {
			"type": "string",
			"default": "default"
		},
		"iconShape": {
			"type": "string",
			"default": "circle"
		},
		"title": {
			"type": "string",
			"default": "This is the heading"
		},
		"titleTag": {
			"type": "string",
			"default": "h2"
		},
		"description": {
			"type": "string",
			"default": "Lorem ipsum dolor sit amet consectetur adipiscing elit dolor"
		},
		"descriptionTag": {
			"type": "string",
			"default": "div"
		},
		"button": {
			"type": "string",
			"default": "Click Here"
		},
		"buttonSize": {
			"type": "string",
			"default": "sm"
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"default": ""
		},
		"linkRel": {
			"type": "string",
			"default": ""
		},
		"linkClick": {
			"type": "string",
			"default": "button"
		},
		"ribbonTitle": {
			"type": "string",
			"default": ""
		},
		"ribbonPosition": {
			"type": "string",
			"default": "right"
		},
		"verticalPosition": {
			"type": "string",
			"default": "middle"
		},
		"contentAnimation": {
			"type": "string",
			"default": "grow"
		},
		"bgTransform": {
			"type": "string",
			"default": "zoom-in"
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"customCSS": false
	},
	"example": {
		"attributes": {
			"title": "This is the heading",
			"description": "Lorem ipsum dolor sit amet consectetur adipiscing elit dolor",
			"button": "Click Here"
		}
	},
	"render": "file:../../includes/sections/call-to-action.php"
}
