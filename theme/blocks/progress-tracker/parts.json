{
	"parts": [
		{
			"key": "tracker",
			"label": "Tracker (size, border)",
			"selector": " .elementor-scrolling-tracker",
			"controls": [
				"size",
				"border",
				"padding",
				"shadow"
			]
		},
		{
			"key": "progress",
			"label": "Progress (a bar's colour and border)",
			"selector": " .elementor-scrolling-tracker-horizontal .current-progress",
			"controls": [
				"background",
				"border"
			],
			"when": {
				"trackerType": [
					"horizontal"
				]
			}
		},
		{
			"key": "circleProgress",
			"label": "Circle: progress colour",
			"selector": " .elementor-scrolling-tracker-circular .current-progress",
			"controls": [
				"color"
			],
			"when": {
				"trackerType": [
					"circular"
				]
			}
		},
		{
			"key": "circleTrack",
			"label": "Circle: track colour",
			"selector": " .elementor-scrolling-tracker-circular .circle-tracker-background",
			"controls": [
				"color"
			],
			"when": {
				"trackerType": [
					"circular"
				]
			}
		},
		{
			"key": "percentage",
			"label": "Percentage",
			"selector": " .current-progress-percentage",
			"controls": [
				"color",
				"typography",
				"textShadow",
				"padding"
			],
			"when": {
				"percentage": [
					true
				]
			}
		}
	]
}
