{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/document",
	"title": "Elementor document",
	"category": "layout",
	"description": "The box around a page's sections, or a shared section's blocks.",
	"textdomain": "harlow",
	"attributes": {
		"docType": {
			"type": "string",
			"default": "container"
		},
		"docId": {
			"type": "integer",
			"default": 0
		},
		"postType": {
			"type": "string",
			"default": "elementor_library"
		},
		"location": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"render": "file:../../includes/sections/document.php"
}
