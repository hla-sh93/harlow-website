{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/heading",
	"title": "Heading",
	"category": "text",
	"description": "A title or a short line of words, in the design's heading styles.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"tag": {
			"type": "string",
			"default": "h2"
		},
		"size": {
			"type": "string",
			"default": "default"
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"source": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"render": "file:../../includes/sections/heading.php"
}
