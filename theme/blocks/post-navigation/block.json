{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/post-navigation",
	"title": "Post Navigation",
	"category": "theme",
	"description": "Links to the item before and after the one the page shows, with labels, titles and arrows (Elementor Pro's post navigation widget).",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		},
		"prevLabel": {
			"type": "string",
			"default": "Previous"
		},
		"nextLabel": {
			"type": "string",
			"default": "Next"
		},
		"showArrow": {
			"type": "boolean",
			"default": true
		},
		"arrow": {
			"type": "string",
			"enum": [
				"angle",
				"angle-double",
				"chevron",
				"caret",
				"arrow"
			],
			"default": "angle"
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"showBorders": {
			"type": "boolean",
			"default": true
		},
		"sameTerm": {
			"type": "boolean",
			"default": false
		},
		"taxonomy": {
			"type": "string",
			"default": "category"
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"example": {
		"attributes": {
			"showBorders": true
		}
	},
	"render": "file:../../includes/sections/post-navigation.php"
}
