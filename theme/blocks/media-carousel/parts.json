{
	"parts": [
		{
			"key": "slides",
			"label": "Slides",
			"selector": " .elementor-main-swiper .swiper-slide",
			"controls": [
				"background",
				"padding",
				"border",
				"shadow"
			]
		},
		{
			"key": "carousel",
			"label": "Carousel",
			"selector": " .elementor-main-swiper",
			"controls": [
				"size"
			]
		},
		{
			"key": "arrows",
			"label": "Navigation arrows",
			"selector": " .elementor-swiper-button",
			"controls": [
				"icon",
				"background",
				"padding",
				"border"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .elementor-swiper-button:hover"
				}
			},
			"when": {
				"showArrows": [
					true
				]
			}
		},
		{
			"key": "dots",
			"label": "Pagination",
			"selector": " .swiper-pagination-bullet| .swiper-pagination-progressbar-fill",
			"controls": [
				"size",
				"background",
				"opacity",
				"margin"
			],
			"states": {
				"active": {
					"label": "Active",
					"selector": " .swiper-pagination-bullet.swiper-pagination-bullet-active"
				}
			},
			"when": {
				"pagination": [
					"bullets",
					"progressbar"
				]
			}
		},
		{
			"key": "fraction",
			"label": "Fraction",
			"selector": " .swiper-pagination-fraction",
			"controls": [
				"color",
				"typography"
			],
			"when": {
				"pagination": [
					"fraction"
				]
			}
		},
		{
			"key": "playIcon",
			"label": "Play Icon",
			"selector": " .elementor-custom-embed-play",
			"controls": [
				"icon",
				"textShadow",
				"opacity"
			],
			"when": {
				"slides": {
					"any": {
						"type": [
							"video"
						],
						"video": "*"
					}
				}
			}
		},
		{
			"key": "overlay",
			"label": "Overlay",
			"selector": " .elementor-carousel-image-overlay",
			"controls": [
				"background",
				"padding"
			],
			"when": {
				"overlay": [
					"text",
					"icon"
				]
			}
		},
		{
			"key": "overlayWords",
			"label": "Overlay: words",
			"selector": " .elementor-carousel-image-overlay",
			"controls": [
				"color",
				"typography"
			],
			"when": {
				"overlay": [
					"text"
				]
			}
		},
		{
			"key": "overlayIcon",
			"label": "Overlay: icon",
			"selector": " .elementor-carousel-image-overlay",
			"controls": [
				"icon"
			],
			"when": {
				"overlay": [
					"icon"
				]
			}
		},
		{
			"key": "thumbnails",
			"label": "Thumbnails",
			"selector": " .elementor-thumbnails-swiper .swiper-slide",
			"controls": [
				"border",
				"opacity"
			],
			"states": {
				"active": {
					"label": "Active",
					"selector": " .elementor-thumbnails-swiper .swiper-slide.swiper-slide-active"
				}
			},
			"when": {
				"skin": [
					"slideshow"
				]
			}
		},
		{
			"key": "lightbox",
			"label": "Lightbox (shown when a picture is opened)",
			"selector": " > .elementor-lightbox",
			"controls": [
				"background"
			]
		},
		{
			"key": "lightboxClose",
			"label": "Lightbox UI (shown when a picture is opened)",
			"selector": " > .elementor-lightbox .dialog-lightbox-close-button",
			"controls": [
				"icon"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " > .elementor-lightbox .dialog-lightbox-close-button:hover"
				}
			}
		}
	]
}
