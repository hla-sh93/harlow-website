{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/shortcode",
	"title": "Shortcode output",
	"category": "widgets",
	"description": "What a plugin's shortcode printed (a form, the group chart).",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"html": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"render": "file:../../includes/sections/shortcode.php"
}
