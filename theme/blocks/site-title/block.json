{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/site-title",
	"title": "Site Title",
	"category": "theme",
	"description": "The site's name as a heading, linked to the home page (Elementor Pro's site title widget).",
	"textdomain": "harlow",
	"harlowWidget": "theme-site-title",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"tag": {
			"type": "string",
			"default": "h2"
		},
		"size": {
			"type": "string",
			"default": "default"
		},
		"linkTo": {
			"type": "string",
			"enum": [
				"none",
				"home",
				"item",
				"custom"
			],
			"default": "home"
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"default": ""
		},
		"linkRel": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"example": {
		"attributes": {
			"tag": "h2"
		}
	},
	"render": "file:../../includes/sections/site-title.php"
}
