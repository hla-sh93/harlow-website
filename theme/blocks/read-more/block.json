{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/read-more",
	"title": "Read More",
	"category": "text",
	"description": "Where a post is cut when it is listed: the rest is behind a “Continue reading” link to the post.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": "Continue reading"
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"example": {
		"attributes": {
			"text": "Continue reading"
		}
	},
	"render": "file:../../includes/sections/read-more.php"
}
