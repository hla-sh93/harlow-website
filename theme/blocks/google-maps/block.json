{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/google-maps",
	"title": "Google Maps",
	"icon": "location-alt",
	"category": "embed",
	"description": "A place on Google's map, found by its address.",
	"textdomain": "harlow",
	"harlowWidget": "google_maps",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"address": {
			"type": "string",
			"default": "London Eye, London, United Kingdom"
		},
		"zoom": {
			"type": "number",
			"default": 10
		},
		"height": {
			"type": "string",
			"default": ""
		},
		"heightTablet": {
			"type": "string",
			"default": ""
		},
		"heightMobile": {
			"type": "string",
			"default": ""
		},
		"heightUnit": {
			"type": "string",
			"default": "px"
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"customCSS": false
	},
	"example": {
		"attributes": {
			"element": "a1b2c3d",
			"classes": "elementor-element elementor-widget elementor-widget-google_maps"
		}
	},
	"render": "file:../../includes/sections/google-maps.php"
}
