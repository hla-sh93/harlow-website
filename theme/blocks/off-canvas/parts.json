{
	"parts": [
		{
			"key": "box",
			"label": "Box",
			"selector": " .e-off-canvas__main",
			"controls": [
				"size",
				"padding",
				"border",
				"shadow"
			]
		},
		{
			"key": "overlay",
			"label": "Overlay",
			"selector": " .e-off-canvas__overlay",
			"controls": [
				"background",
				"opacity"
			],
			"when": {
				"overlay": [
					true
				]
			}
		},
		{
			"key": "close",
			"label": "Close icon",
			"selector": " .e-off-canvas__close",
			"controls": [
				"icon",
				"background",
				"padding",
				"border",
				"margin"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .e-off-canvas__close:hover"
				}
			},
			"when": {
				"closeButton": [
					true
				]
			}
		}
	]
}
