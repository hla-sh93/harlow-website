{
	"parts": [
		{
			"key": "headline",
			"label": "Headline",
			"selector": " .elementor-headline| .elementor-headline-plain-text",
			"controls": [
				"align",
				"color",
				"typography",
				"textShadow"
			]
		},
		{
			"key": "animated",
			"label": "Animated text",
			"selector": " .elementor-headline-dynamic-text",
			"controls": [
				"color",
				"typography",
				"textShadow"
			]
		},
		{
			"key": "shape",
			"label": "Shape (its colour)",
			"selector": " .elementor-headline-dynamic-wrapper svg",
			"controls": [
				"color",
				"opacity"
			],
			"when": {
				"headlineStyle": [
					"highlight"
				]
			}
		},
		{
			"key": "selected",
			"label": "While typing: selected words",
			"selector": " .elementor-headline-typing-selected| .elementor-headline-typing-selected .elementor-headline-dynamic-text",
			"controls": [
				"color",
				"background"
			],
			"when": {
				"headlineStyle": [
					"rotate"
				],
				"animationType": [
					"typing"
				]
			}
		},
		{
			"key": "cursor",
			"label": "Cursor (typing and clip)",
			"selector": " .elementor-headline-dynamic-wrapper:after",
			"controls": [
				"background"
			],
			"when": {
				"headlineStyle": [
					"rotate"
				],
				"animationType": [
					"typing",
					"clip"
				]
			}
		}
	]
}
