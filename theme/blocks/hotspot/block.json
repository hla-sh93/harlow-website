{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/hotspot",
	"title": "Hotspot",
	"icon": "location",
	"category": "media",
	"description": "A picture with spots on it that show a tooltip or lead to a link.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"image": {
			"type": "integer",
			"default": 0
		},
		"imageSize": {
			"type": "string",
			"default": "full"
		},
		"alt": {
			"type": "string",
			"default": ""
		},
		"hotspots": {
			"type": "array",
			"default": [
				{
					"id": "",
					"label": "",
					"icon": "",
					"link": "",
					"linkTarget": "",
					"linkRel": "",
					"x": 30,
					"horizontal": "left",
					"y": 40,
					"vertical": "top",
					"tooltip": "Add Your Tooltip Text Here",
					"tooltipPosition": ""
				},
				{
					"id": "",
					"label": "",
					"icon": "",
					"link": "",
					"linkTarget": "",
					"linkRel": "",
					"x": 65,
					"horizontal": "left",
					"y": 60,
					"vertical": "top",
					"tooltip": "Add Your Tooltip Text Here",
					"tooltipPosition": ""
				}
			]
		},
		"tooltipPosition": {
			"type": "string",
			"default": "top"
		},
		"tooltipTrigger": {
			"type": "string",
			"default": "click"
		},
		"tooltipAnimation": {
			"type": "string",
			"default": "e-hotspot--fade-in-out"
		},
		"tooltipDuration": {
			"type": "number",
			"default": 500
		},
		"hotspotAnimation": {
			"type": "string",
			"default": "e-hotspot--expand"
		},
		"sequenced": {
			"type": "boolean",
			"default": false
		},
		"sequencedDuration": {
			"type": "number",
			"default": 1000
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"customCSS": false
	},
	"example": {
		"attributes": {
			"element": "a1b2c3d",
			"classes": "elementor-element elementor-widget elementor-widget-hotspot"
		}
	},
	"render": "file:../../includes/sections/hotspot.php"
}
