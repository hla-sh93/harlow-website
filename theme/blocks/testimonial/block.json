{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/testimonial",
	"title": "Testimonial",
	"category": "text",
	"description": "What someone said, with their picture, name and title.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"content": {
			"type": "string",
			"default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo."
		},
		"image": {
			"type": "integer",
			"default": 0
		},
		"imageSize": {
			"type": "string",
			"default": "full"
		},
		"name": {
			"type": "string",
			"default": "John Doe"
		},
		"job": {
			"type": "string",
			"default": "Designer"
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"default": ""
		},
		"linkRel": {
			"type": "string",
			"default": ""
		},
		"imagePosition": {
			"type": "string",
			"default": "aside"
		},
		"align": {
			"type": "string",
			"default": "center"
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"example": {
		"attributes": {
			"name": "John Doe",
			"job": "Designer",
			"imagePosition": "aside",
			"align": "center"
		}
	},
	"render": "file:../../includes/sections/testimonial.php"
}
