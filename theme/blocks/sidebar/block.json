{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/sidebar",
	"title": "Sidebar",
	"category": "widgets",
	"description": "The widgets of a widget area (Appearance → Widgets), as Elementor's sidebar widget prints them.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"sidebar": {
			"type": "string",
			"default": ""
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"example": {
		"attributes": {
			"sidebar": "harlow-sidebar"
		}
	},
	"render": "file:../../includes/sections/sidebar.php"
}
