{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/container",
	"title": "Container",
	"category": "layout",
	"description": "A box that holds other blocks: a section, a column, a row of cards.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"boxed": {
			"type": "boolean",
			"default": false
		},
		"video": {
			"type": "string",
			"default": ""
		},
		"picture": {
			"type": "integer",
			"default": 0
		},
		"tag": {
			"type": "string",
			"default": "div"
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"linkNewTab": {
			"type": "boolean",
			"default": false
		},
		"videoStart": {
			"type": "string",
			"default": ""
		},
		"videoEnd": {
			"type": "string",
			"default": ""
		},
		"videoOnce": {
			"type": "boolean",
			"default": false
		},
		"videoMobile": {
			"type": "boolean",
			"default": true
		},
		"videoFallback": {
			"type": "integer",
			"default": 0
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"render": "file:../../includes/sections/container.php"
}
