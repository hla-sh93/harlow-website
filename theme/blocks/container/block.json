{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/container",
	"title": "Container",
	"category": "layout",
	"description": "A box that holds other blocks: a section, a column, a row of cards.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"boxed": {
			"type": "boolean",
			"default": false
		},
		"video": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"render": "file:../../includes/sections/container.php"
}
