{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/facebook-comments",
	"title": "Facebook Comments",
	"category": "embed",
	"description": "Facebook’s comments box, for this page or another address.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"commentsNumber": {
			"type": "number",
			"default": 10
		},
		"orderBy": {
			"type": "string",
			"default": "social"
		},
		"urlType": {
			"type": "string",
			"default": "current_page"
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"urlFormat": {
			"type": "string",
			"default": "plain"
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"example": {
		"attributes": {
			"commentsNumber": 10
		}
	},
	"render": "file:../../includes/sections/facebook-comments.php"
}
