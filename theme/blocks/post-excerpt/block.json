{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/post-excerpt",
	"title": "Post Excerpt",
	"category": "theme",
	"description": "The excerpt of the item the page shows (Elementor Pro's post excerpt widget).",
	"textdomain": "harlow",
	"harlowWidget": "theme-post-excerpt",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"length": {
			"type": "integer",
			"default": 0
		},
		"fromContent": {
			"type": "boolean",
			"default": true
		},
		"readMore": {
			"type": "boolean",
			"default": false
		},
		"readMoreText": {
			"type": "string",
			"default": "Read More »"
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"example": {
		"attributes": {
			"length": 25
		}
	},
	"render": "file:../../includes/sections/post-excerpt.php"
}
