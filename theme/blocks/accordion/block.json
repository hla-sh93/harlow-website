{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/accordion",
	"title": "Accordion",
	"category": "text",
	"description": "Questions that open their answers one at a time.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"iconClosed": {
			"type": "string",
			"default": ""
		},
		"iconOpened": {
			"type": "string",
			"default": ""
		}
	},
	"providesContext": {
		"harlow/iconClosed": "iconClosed",
		"harlow/iconOpened": "iconOpened"
	},
	"allowedBlocks": [
		"harlow/accordion-item"
	],
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"render": "file:../../includes/sections/accordion.php"
}
