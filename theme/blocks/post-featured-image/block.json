{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/post-featured-image",
	"title": "Featured Image",
	"category": "theme",
	"description": "The featured picture of the item the page shows, with its link and caption (Elementor Pro's featured image widget).",
	"textdomain": "harlow",
	"harlowWidget": "theme-post-featured-image",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"size": {
			"type": "string",
			"enum": [
				"thumbnail",
				"medium",
				"medium_large",
				"large",
				"full"
			],
			"default": "large"
		},
		"fallback": {
			"type": "integer",
			"default": 0
		},
		"captionSource": {
			"type": "string",
			"enum": [
				"none",
				"attachment",
				"custom"
			],
			"default": "none"
		},
		"caption": {
			"type": "string",
			"default": ""
		},
		"linkTo": {
			"type": "string",
			"enum": [
				"none",
				"file",
				"item",
				"custom"
			],
			"default": "none"
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"default": ""
		},
		"linkRel": {
			"type": "string",
			"default": ""
		},
		"lightbox": {
			"type": "boolean",
			"default": true
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"example": {
		"attributes": {
			"size": "large"
		}
	},
	"render": "file:../../includes/sections/post-featured-image.php"
}
