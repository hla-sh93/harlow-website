{
	"parts": [
		{
			"key": "card",
			"label": "Card",
			"selector": " .e-loop-item",
			"controls": [
				"background",
				"border",
				"shadow",
				"padding",
				"opacity"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .e-loop-item:hover"
				}
			}
		},
		{
			"key": "cardPicture",
			"label": "Card: picture",
			"selector": " .e-loop-item .elementor-widget-image img| .e-loop-item .elementor-widget-theme-post-featured-image img",
			"controls": [
				"border",
				"shadow",
				"opacity",
				"size"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .e-loop-item:hover .elementor-widget-image img| .e-loop-item:hover .elementor-widget-theme-post-featured-image img"
				}
			}
		},
		{
			"key": "cardTitle",
			"label": "Card: title",
			"selector": " .e-loop-item .elementor-heading-title",
			"controls": [
				"color",
				"typography",
				"textShadow",
				"margin"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .e-loop-item:hover .elementor-heading-title"
				}
			}
		},
		{
			"key": "cardText",
			"label": "Card: text",
			"selector": " .e-loop-item .elementor-widget-text-editor| .e-loop-item .elementor-widget-theme-post-excerpt",
			"controls": [
				"color",
				"typography",
				"margin"
			]
		},
		{
			"key": "cardButton",
			"label": "Card: button",
			"selector": " .e-loop-item .elementor-button",
			"controls": [
				"color",
				"typography",
				"background",
				"border",
				"padding"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .e-loop-item .elementor-button:hover"
				}
			}
		},
		{
			"key": "grid",
			"label": "Grid",
			"selector": " .elementor-loop-container",
			"controls": [
				"columns",
				"gap"
			]
		},
		{
			"key": "arrows",
			"label": "Arrows",
			"selector": " .elementor-swiper-button",
			"controls": [
				"icon",
				"background",
				"padding",
				"border"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .elementor-swiper-button:hover"
				}
			},
			"when": {
				"layout": [
					"carousel"
				]
			}
		},
		{
			"key": "dots",
			"label": "Dots",
			"selector": " .swiper-pagination-bullet",
			"controls": [
				"background",
				"size",
				"margin"
			],
			"states": {
				"active": {
					"label": "Active",
					"selector": " .swiper-pagination-bullet-active"
				}
			},
			"when": {
				"layout": [
					"carousel"
				],
				"dots": [
					true
				]
			}
		},
		{
			"key": "pager",
			"label": "Page numbers",
			"selector": " .elementor-pagination .page-numbers",
			"controls": [
				"color",
				"typography",
				"textShadow",
				"padding",
				"background"
			],
			"states": {
				"active": {
					"label": "Current",
					"selector": " .elementor-pagination .page-numbers.current"
				}
			},
			"when": {
				"pagination": [
					"numbers"
				]
			}
		}
	]
}
