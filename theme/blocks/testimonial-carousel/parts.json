{
	"parts": [
		{
			"key": "slides",
			"label": "Slides",
			"selector": " .swiper-slide",
			"controls": [
				"background",
				"border",
				"padding",
				"shadow",
				"align"
			]
		},
		{
			"key": "content",
			"label": "Content",
			"selector": " .elementor-testimonial__text",
			"controls": [
				"color",
				"typography",
				"textShadow"
			]
		},
		{
			"key": "bubble",
			"label": "Content box (gap, bubble)",
			"selector": " .elementor-testimonial__content",
			"controls": [
				"background",
				"padding",
				"margin",
				"border"
			]
		},
		{
			"key": "image",
			"label": "Image",
			"selector": " .elementor-testimonial__image img",
			"controls": [
				"size",
				"margin",
				"border",
				"shadow"
			]
		},
		{
			"key": "name",
			"label": "Name",
			"selector": " .elementor-testimonial__name",
			"controls": [
				"color",
				"typography",
				"textShadow"
			]
		},
		{
			"key": "title",
			"label": "Title",
			"selector": " .elementor-testimonial__title",
			"controls": [
				"color",
				"typography",
				"textShadow"
			]
		},
		{
			"key": "arrows",
			"label": "Navigation: arrows",
			"selector": " .elementor-swiper-button",
			"controls": [
				"icon",
				"opacity"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .elementor-swiper-button:hover"
				}
			}
		},
		{
			"key": "dots",
			"label": "Navigation: dots",
			"selector": " .swiper-pagination-bullet",
			"controls": [
				"background",
				"size",
				"opacity",
				"margin"
			],
			"states": {
				"active": {
					"label": "Active",
					"selector": " .swiper-pagination-bullet.swiper-pagination-bullet-active"
				}
			}
		},
		{
			"key": "pagination",
			"label": "Navigation: fraction and progress",
			"selector": " .swiper-pagination-fraction| .swiper-pagination-progressbar",
			"controls": [
				"color",
				"typography",
				"background"
			]
		}
	]
}
