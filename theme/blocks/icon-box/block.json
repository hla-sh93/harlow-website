{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/icon-box",
	"title": "Icon Box",
	"icon": "info",
	"category": "design",
	"description": "An icon with a title and words, above them or beside them, with a link if wanted.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"icon": {
			"type": "string",
			"default": "<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-star\" viewBox=\"0 0 576 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M259.3 17.8L194 150.2 47.9 171.5c-26.2 3.8-36.7 36.1-17.7 54.6l105.7 103-25 145.5c-4.5 26.3 23.2 46 46.4 33.7L288 439.6l130.7 68.7c23.2 12.2 50.9-7.4 46.4-33.7l-25-145.5 105.7-103c19-18.5 8.5-50.8-17.7-54.6L382 150.2 316.7 17.8c-11.7-23.6-45.6-23.9-57.4 0z\"></path></svg>"
		},
		"view": {
			"type": "string",
			"default": "default"
		},
		"shape": {
			"type": "string",
			"default": "circle"
		},
		"title": {
			"type": "string",
			"default": "This is the heading"
		},
		"description": {
			"type": "string",
			"default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo."
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"default": ""
		},
		"linkRel": {
			"type": "string",
			"default": ""
		},
		"position": {
			"type": "string",
			"default": "top"
		},
		"titleTag": {
			"type": "string",
			"default": "h3"
		},
		"verticalAlign": {
			"type": "string",
			"default": "top"
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"customCSS": false
	},
	"example": {
		"attributes": {
			"title": "This is the heading",
			"description": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
		}
	},
	"render": "file:../../includes/sections/icon-box.php"
}
