{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/gallery",
	"title": "Gallery",
	"icon": "format-gallery",
	"category": "media",
	"description": "Pictures in a grid that open in the lightbox: chosen here, or the pictures of the item the page shows.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"pictures": {
			"type": "array",
			"default": [],
			"items": {
				"type": "integer"
			}
		},
		"source": {
			"type": "string",
			"default": ""
		},
		"captions": {
			"type": "boolean",
			"default": false
		},
		"style": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"customCSS": false
	},
	"render": "file:../../includes/sections/gallery.php"
}
