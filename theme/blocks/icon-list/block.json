{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "harlow/icon-list",
	"title": "Icon list",
	"category": "text",
	"description": "A list of lines, each with an icon and a link if it has one.",
	"textdomain": "harlow",
	"attributes": {
		"element": {
			"type": "string",
			"default": ""
		},
		"classes": {
			"type": "string",
			"default": ""
		},
		"settings": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"inline": {
			"type": "boolean",
			"default": false
		},
		"items": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"render": "file:../../includes/sections/icon-list.php"
}
