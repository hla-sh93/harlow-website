{
	"parts": [
		{
			"key": "video",
			"label": "Video",
			"selector": " .elementor-wrapper",
			"controls": [
				"opacity",
				"border",
				"shadow"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .elementor-wrapper:hover"
				}
			}
		},
		{
			"key": "playIcon",
			"label": "Play Icon",
			"selector": " .elementor-custom-embed-play",
			"controls": [
				"icon",
				"textShadow",
				"opacity"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .elementor-custom-embed-image-overlay:hover .elementor-custom-embed-play"
				}
			},
			"when": {
				"showImageOverlay": [
					true
				],
				"imageOverlay": "*",
				"showPlayIcon": [
					true
				]
			}
		},
		{
			"key": "lightbox",
			"label": "Lightbox (shown when the video is opened)",
			"selector": " > .elementor-lightbox",
			"controls": [
				"background"
			],
			"when": {
				"lightbox": [
					true
				]
			}
		},
		{
			"key": "lightboxClose",
			"label": "Lightbox UI (shown when the video is opened)",
			"selector": " > .elementor-lightbox .dialog-lightbox-close-button",
			"controls": [
				"icon"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " > .elementor-lightbox .dialog-lightbox-close-button:hover"
				}
			},
			"when": {
				"lightbox": [
					true
				]
			}
		}
	]
}
