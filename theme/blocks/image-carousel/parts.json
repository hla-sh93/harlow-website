{
	"parts": [
		{
			"key": "arrows",
			"label": "Arrows",
			"selector": " .elementor-swiper-button",
			"controls": [
				"icon",
				"background",
				"padding",
				"border",
				"shadow"
			],
			"states": {
				"hover": {
					"label": "Hover",
					"selector": " .elementor-swiper-button:hover"
				}
			},
			"when": {
				"navigation": [
					"both",
					"arrows"
				],
				"pictures": "*"
			}
		},
		{
			"key": "dots",
			"label": "Dots",
			"selector": " .swiper-pagination-bullet",
			"controls": [
				"size",
				"background",
				"opacity",
				"margin",
				"border"
			],
			"states": {
				"active": {
					"label": "Active",
					"selector": " .swiper-pagination-bullet.swiper-pagination-bullet-active"
				}
			},
			"when": {
				"navigation": [
					"both",
					"dots"
				],
				"pictures": "*"
			}
		},
		{
			"key": "dotsPlace",
			"label": "Dots place",
			"selector": " .swiper-pagination",
			"controls": [
				"align",
				"margin"
			],
			"when": {
				"navigation": [
					"both",
					"dots"
				],
				"pictures": "*"
			}
		},
		{
			"key": "image",
			"label": "Image",
			"selector": " .swiper-slide-image",
			"controls": [
				"border",
				"shadow",
				"opacity"
			],
			"when": {
				"pictures": "*"
			}
		},
		{
			"key": "caption",
			"label": "Caption",
			"selector": " .elementor-image-carousel-caption",
			"controls": [
				"align",
				"color",
				"typography",
				"textShadow",
				"background",
				"padding",
				"margin"
			],
			"when": {
				"pictures": "*",
				"captionType": [
					"caption",
					"title",
					"description"
				]
			}
		}
	]
}
