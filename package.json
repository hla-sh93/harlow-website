{
	"name": "harlow-theme",
	"version": "0.1.0",
	"private": true,
	"description": "Build and lint tooling for the Harlow Group theme: the block editor bundle (wp-scripts build, committed in theme/build/) and the WordPress JavaScript coding standards (wp-scripts lint-js). The theme itself needs none of this to run.",
	"scripts": {
		"build": "wp-scripts build theme/editor/index.js --output-path=theme/build",
		"start": "wp-scripts start theme/editor/index.js --output-path=theme/build",
		"lint": "wp-scripts lint-js theme/editor theme/blocks theme/admin"
	},
	"devDependencies": {
		"@wordpress/scripts": "^35.0.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/escape-html": "^4.0.0",
		"@wordpress/hooks": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/url": "^5.0.0"
	}
}
